+def export_all_assets(index="_all", doc_type="data", page_size=1000):
+    results = []
+    from_offset = 0
+    while True:
+        s = Search(using=es, index=index, doc_type=doc_type)
+        s = s.from_(from_offset).size(page_size)
+        response = s.execute()
+        hits = response.hits
+        if not hits:
+            break
+        for hit in hits:
+            results.append(hit.to_dict())
+        if len(hits) < page_size:
+            break
+        from_offset += page_size
+    return results
